  "verification_statuses": [
    "verified_exact",
    "alias_unverified_checkpoint",
    "hosted_identity_unknown",
    "unverified"
  ],
  "verification_meaning": {
    "verified_exact": "The Neuronpedia ids were read in a primary source and the hosted checkpoint revision is recorded and equals the study revision. The only status that permits an exact link, pooling of hosted and local results, or a parity statement. A reference link does not depend on this status and is not evidence for it.",
    "alias_unverified_checkpoint": "Another id is given for the same checkpoint by the source that the entry's id_source names. No record of the checkpoint revision behind that id was read. An alias alone verifies nothing.",
    "hosted_identity_unknown": "The engine uses these hosted ids and responses have landed. The engine records no model, dictionary or instrument revision for these responses. The entry's evidence names the records of the service that were read and says that none of them carries a revision, or says that none was read. What answered is therefore not identified by commit.",
    "unverified": "The representation is named in a source that was read. Its own manifest or page was not read."
  },
  "reference_statuses": [
    "service_record_read_revision_not_reported",
    "no_service_record"
  ],
  "reference_meaning": {
    "service_record_read_revision_not_reported": "The service's own record for the entry's Neuronpedia ids was read and is saved; reference.evidence names it by path, SHA-256, size and retrieval time. The record names the entry's model id and a Hugging Face repository equal to the study's, and reports no revision, commit or hash. Permits a reference link to a page form listed in reference.pages. Says nothing about the hosted checkpoint: the verification status is unchanged by it, and it permits no exact link, no pooling and no parity statement.",
    "no_service_record": "The entry names no saved record of the service for its ids: it records no Neuronpedia ids, or no record was saved. No reference link."
  },
