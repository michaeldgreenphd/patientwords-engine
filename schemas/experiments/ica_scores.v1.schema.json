{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "patientwords.ica-scores/1",
  "title": "ICA scores payload (kind ica_scores/1)",
  "description": "Signed scores, squared-coordinate shares and reconstruction error of one family variant under one fixed ICA basis. Structure only, in the keyword subset scripts/frontend_contract_schema.py executes. The payload kind, equality of every fixed statement with the adapter's constants, the limitations list, the capture site, the exact key set of split_leakage_checks and the closed list of words under each key, the dataset file hashes, recomputation of every share from the row's scores, row alignment with the protocol's token ids, completeness of the component list, finiteness and the rule that an undefined share is null (never zero) are enforced by scripts/experiments/adapters/ica.py. An energy share is a squared-coordinate share. It is not a probability and not an importance. Scores are signed as saved and are not comparable across fits, layers or models.",
  "type": "object",
  "required": [
    "kind",
    "synthetic",
    "family_id",
    "variant",
    "input",
    "model",
    "tokenizer",
    "identity",
    "basis",
    "capture",
    "split_leakage_checks",
    "execution_path",
    "rows",
    "components_complete",
    "score_definition",
    "scores",
    "energy_share",
    "reconstruction",
    "annotation_statement",
    "component_annotations",
    "limitations"
  ],
