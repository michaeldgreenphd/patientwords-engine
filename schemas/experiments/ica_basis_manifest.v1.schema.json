      ],
      "properties": {
        "layer": {
          "type": "integer"
        },
        "component": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "vocabulary_readout": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "method",
            "source",
            "tokens"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "tokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
