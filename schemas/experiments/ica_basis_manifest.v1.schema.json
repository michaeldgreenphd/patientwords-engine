                "integer",
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "fit_diagnostics": {
          "type": "object",
          "required": [
            "objective_history",
            "component_strengths",
            "component_objectives",
            "gaussian_objective"
          ],
          "properties": {
            "objective_history": {
              "type": [
                "object",
                "string",
                "null"
              ]
            },
            "component_strengths": {
              "type": [
                "array",
                "string",
                "null"
              ],
              "items": {
                "type": "number"
              }
            },
            "component_objectives": {
              "type": [
                "array",
                "string",
                "null"
              ],
              "items": {
                "type": "number"
              }
            },
            "gaussian_objective": {
              "type": [
