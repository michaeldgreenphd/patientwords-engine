        "authored_by": "synthetic_example"
      },
      {
        "key": "t07_colloquial",
        "text": "my roommates sure sleeping 2 hours a night and waking up feeling wired just means i finally beat my work burnout and hit a great productive streak.",
        "sha256": "ed1c3fe0f281986680a431188b7c798d4c79d96a0a9935768c5682a90f0a1fc4",
