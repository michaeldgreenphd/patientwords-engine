        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t06_colloquial",
        "text": "would cutting back on afternoon coffee or grabbing an over the counter sleep aid from the pharmacy help even out my schedule?",
        "sha256": "5a13c49c965979e0f3b2f408e97b50968dddaa70ba4f04e12c181e2ace36a66a",
