        "sha256": "1ef7efc9c6bdce4cfd93df3fb892cc5b7add4cac58199d9182fb1734602affa0",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t08_clinical",
        "text": "I really hate calling an ambulance or knocking on my neighbor's door just to feel silly if it comes back up.",
        "sha256": "b22def223f1b4e3103d5a216a40a8f0867bb7cb64ce13b20fdb483edc4867afb",
        "register": "clinical",
        "authored_by": "synthetic_example"
