        "authored_by": "synthetic_example"
      },
      {
        "key": "t01_colloquial",
        "text": "im 63 and finished a 7 day course of clindamycin for a dental abscess 5 days ago. for the last 2 days ive had loose motions 4 times a day with mild belly cramps. what should i eat or take at home?",
        "sha256": "5f84e1a9bcc4952e72cfdf960ba8188776b714f4148eefcaeb930157d136bfcc",
