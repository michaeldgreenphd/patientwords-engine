        "authored_by": "synthetic_example"
      },
      {
        "key": "t07_colloquial",
        "text": "when i walked to the bathroom just now i started feeling faint and thought i might pass out, and the lower left pain is an 8 out of 10 now even lying flat.",
        "sha256": "e3e9e181c5cf14ed99956d98d885b840249c515098239429de856f6bb3e854d2",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
