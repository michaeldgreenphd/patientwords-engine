        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t06_colloquial",
        "text": "ive got a big presentation at 1 this afternoon so i just wanna pop 600 mg of ibuprofen and lie in the dark for 2 hours.",
        "sha256": "eacb9bf0cb53cb10d4108d422c235a95e42fc6599128aa3d5fa6b70f9be3c7f3",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t07_clinical",
        "text": "Would taking ibuprofen with strong black coffee and an ice pack on my neck knock it out faster?",
        "sha256": "e015576ff33c578164f62d400639dc70d99e0bcec57346bb7bc74c648e28f05d",
        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t07_colloquial",
        "text": "would taking ibuprofen with strong black coffee and an ice pack on my neck knock it out quicker?",
        "sha256": "a84f8db7c400f24c1af6217abad32788599fc594bf2d644322a7872898d621d9",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t08_clinical",
