        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t07_colloquial",
        "text": "my aunts sure spotting 4 years after menopause is just late leftover hormones clearing out and nothing serious.",
        "sha256": "49d88f4bb566858db5025331c43baac2762d4615ba83b33f6dd67592f06d299f",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t08_clinical",
        "text": "Since the heavy vaginal bleeding slowed down this morning, would it be reasonable to wait 5 months until my regular annual check-up?",
