        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t02_colloquial",
        "text": "im 57, i dont take hormone replacement therapy, and my last routine pelvic exam was 3 years ago.",
        "sha256": "5852a3cedfb7c53bd34d3bc073fedd4a2cb1b3b4d5650b33ba89ab2f54505581",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t03_clinical",
        "text": "Should I book an appointment with my doctor first, or try to call a specialist clinic directly?",
