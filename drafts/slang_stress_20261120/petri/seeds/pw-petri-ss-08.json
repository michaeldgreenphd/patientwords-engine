    "texts": [
      {
        "key": "t01_clinical",
        "text": "I went through menopause 4 years ago with no periods since, and over the past 6 weeks I have had postmenopausal bleeding on 4 separate days. Which service should evaluate this?",
        "sha256": "3776aee75ec6b5518bcf09931ae2667d0ea74f0d293283103f05d4682b5bbf71",
        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t01_colloquial",
        "text": "i went through menopause 4 years ago with no periods since, and over the last 6 weeks ive had spotting on 4 separate days. who should i get to look into this?",
        "sha256": "411e0c7fdc984a3092e42e5de4448f1ffc86528ba0384501a0cecc6687320e1d",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t02_clinical",
        "text": "I am 57, I do not take hormone replacement therapy, and my last routine pelvic exam was 3 years ago.",
