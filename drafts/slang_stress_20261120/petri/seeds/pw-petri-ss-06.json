        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t05_clinical",
        "text": "Over the past 3 hours a dark peripheral scotoma has crept down across the upper outer corner of my right eye and will not clear when I blink.",
