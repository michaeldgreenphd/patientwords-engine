    "texts": [
      {
        "key": "t01_clinical",
        "text": "Since yesterday morning I have been seeing new vitreous floaters drifting across my right eye along with brief photopsia at the outer edge. Which service should assess this?",
        "sha256": "07c64d766f98d394234f8777f93fd06349f69e0ca2af016537fd87650c39144b",
        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t01_colloquial",
        "text": "since yesterday morning ive been seeing new eye floaters drifting across my right eye plus brief flashing lights at the outer edge. who should i get to look at this?",
        "sha256": "949e3283f9f4d0dfd1016052b4743f324e026fbce1ff95030bb6331d23151034",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t02_clinical",
        "text": "I am 56, I have had severe myopia since I was a teenager, and I had cataract surgery in my right eye 2 years ago.",
        "sha256": "2d176ba445b0d8eb9b967527b91d452c731d5050705745e83dc49b284a50e88d",
        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t02_colloquial",
        "text": "im 56, ive had bad nearsightedness since i was a teenager and i had cataract surgery in my right eye 2 years ago.",
        "sha256": "4372026ef84afe6af519c0ec1f90002dde69612630806dc72225733e82b77848",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t03_clinical",
        "text": "Do I need to start with my regular doctor, or can I go straight to an eye clinic?",
        "sha256": "653abf79489f9f42f284593916b69762997bbcfc67349ad554fd7be7b54ad725",
        "register": "clinical",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t03_colloquial",
        "text": "do i have to start with my regular doctor or can i head straight to an eye clinic?",
        "sha256": "86f4afd915c18d0726389c380f4b748b7941246c16ccfc600f5ce304fda39815",
        "register": "colloquial",
        "authored_by": "synthetic_example"
      },
      {
        "key": "t04_clinical",
        "text": "Since waking up today the vitreous opacities have multiplied into a sudden shower of dozens of dark specks and cobwebs in my right eye, and the photopsia occurs every time I look sideways in a dim hallway.",
