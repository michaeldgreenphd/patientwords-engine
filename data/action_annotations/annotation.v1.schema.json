{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PatientWords action annotation v1 structural contract",
  "description": "Structure is validated before semantic constraints in action_annotations.py and allowed labels in rubric.v1.json. Required-nullable fields must be present; null is not a missing key. No generated defaults or coercion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "actions", "reason"],
  "properties": {
    "status": {"type": "string"},
    "reason": {"type": ["string", "null"]},
    "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}}
  },
  "definitions": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "quote"],
      "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}, "quote": {"type": "string"}}
    },
    "optional_span": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start", "end", "quote"],
      "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}, "quote": {"type": "string"}}
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "stance", "actor", "evidence", "timing", "condition"],
      "properties": {
        "category": {"type": "string"},
        "stance": {"type": "string"},
        "actor": {"type": "string"},
        "evidence": {"$ref": "#/definitions/span"},
        "timing": {"$ref": "#/definitions/optional_span"},
        "condition": {"$ref": "#/definitions/optional_span"}
      }
    }
  }
}
