    "call",
    "headers",
    "base_url",
    "api_key",
    "authorization",
    "extra_body",
    "extra_headers",
    "args",
    "model_args",
    "aws_access_key_id",
    "aws_secret_access_key",
    "aws_session_token",
    "model_base_url"
  ],
