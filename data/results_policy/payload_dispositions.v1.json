{
 "schema": "patientwords.payload-dispositions/1",
 "recorded_utc": "2026-11-11",
 "what_this_is": "Differences between the published gallery payload (data/simulated_scenarios.json in the sibling site repository) and what an export or a release would publish in its place, each with the owner's disposition. scripts/export_frontend_simulated.py and scripts/results_snapshot.py refuse a difference unless an entry here covers exactly it with accept_candidate.",
 "what_it_is_not": "Not a membership rule, not a pin and not a hold on publication: a publish that changes no published measurement and no capability label needs no entry.",
 "checked_by": "scripts/payload_dispositions.py; tests/test_payload_dispositions.py",
 "dispositions": {
  "pending": "the owner has not decided; an export or release that makes this difference is refused",
  "accept_candidate": "the owner accepts the candidate as recorded here (a changed value, or a removal); the difference passes while the reference and candidate values are exactly the recorded ones",
  "keep_reference": "the owner keeps the published value; an export that changes it is refused until the exporter reproduces the published value, and then there is no difference",
  "withhold": "the owner accepts neither value: the row is to show as not measured for this model. An export that still carries a value is refused; the removal, once the exporter makes it, is a new difference with its own entry"
 },
 "rule": "Only accept_candidate passes, and only with decided_by \"owner\" and a decision_ref naming the committed document that records the decision. scripts/payload_dispositions.py propose writes pending entries and nothing else; a decision is entered by hand in a reviewed commit.",
 "omitted": "No prompt, target or token text. 'values' holds numbers, booleans, counts and lengths; measurement_sha256 covers the tokens (the row hash of legacy_payload_rows.v1.json without the urgency join).",
 "open_decisions": {
  "explained_in": "docs/corrections/payload_summary_dedupe_20261110.md, section 8",
  "D1": "qwen3-4b on rows 3 to 13 of pairs_20260706T201750Z: a full export removes the model from these rows",
  "D4": "qwen3-4b on rows 1 and 2 of pairs_20260706T201750Z: a full export replaces the published logits-lane values with the hosted values of 2026-09-02"
 },
