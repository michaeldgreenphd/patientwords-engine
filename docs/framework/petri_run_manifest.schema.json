      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable",
            "not_run"
          ],
          "description": "pass: examined and clean. fail: examined and violated (detail names where). not_applicable: nothing in this run for the check to examine (a tools check on seeds that declare none); counts as clean for claim-grade eligibility. not_run: the check did not execute; never eligible."
        },
        "detail": {
          "type": [
