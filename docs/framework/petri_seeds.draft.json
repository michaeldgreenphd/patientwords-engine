{
  "schema_version": "0.1",
  "status": "draft pending owner review",
  "_readme": "Seed definitions for Petri-hosted, PatientWords-owned experiments (docs/petri_integration_design.md sections 5 and 9). seed_schema is the JSON Schema every seed must satisfy; seeds holds six synthetic examples with computed digests: wave 1 covers the three Petri-specific capabilities the first pilot must prove (scripted multi-turn continuation under both exposure protocols, true shared-prefix branching, fixed simulated tools); wave 2 holds the H2 and H5 draft protocol shapes. The scripted controller (scripts/petri_audit/controller.py) executes a seed verbatim: it stages texts as user turns, forks at branch_anchor, stages tools.results as tool results, and never writes text of its own. Real seeds reference stimuli in data/advice/ or data/simulated/ through scenario.source and copy the text plus sha256 so the export can assert byte identity. No real patient text; the examples are invented. tests/test_petri_framework_data.py validates this file.",
  "seed_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PatientWords scripted-protocol seed for a Petri-hosted experiment, draft 0.2",
    "description": "One seed = one scenario's scripted protocol. In Petri's vocabulary a seed instruction is free text to an LLM auditor; in PatientWords a seed is DATA the scripted controller executes verbatim. A seed with mode 'autonomous' carries a free-text auditor instruction and is exploratory by construction. Lists of keyed entries are arrays with an id, as in the framing registry, so the framework validator checks every entry. Medical vocabulary lives here and in the stimuli files a seed references, never in Python. Draft 0.2 (owner corrections 2026-09-16): speaker identity is held constant unless declared a factor, register exposure names its protocol, seeds carry a pilot wave, and the judge block requests both tier instruments and declares supplied contexts.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "seed_id",
      "mode",
      "claim_grade_eligible",
      "hypotheses",
      "pilot_wave",
      "framing",
      "speaker_identity",
      "scenario",
      "texts",
      "system_prompt",
      "tools",
      "protocol",
      "auditor_instruction",
      "generation",
      "judge",
      "status",
      "notes"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": [
          "0.2"
        ]
      },
      "seed_id": {
        "type": "string",
        "pattern": "^pw-petri-[a-z0-9-]+$"
      },
      "mode": {
        "type": "string",
        "enum": [
          "scripted",
          "autonomous"
        ],
        "description": "scripted: every target-visible turn comes from texts; autonomous: an LLM auditor writes turns."
      },
      "claim_grade_eligible": {
        "type": "boolean",
        "description": "true only for mode scripted; the measurement contract (design memo section 5) is checked at export, not here."
      },
      "hypotheses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^H[1-6]$"
        }
      },
      "pilot_wave": {
        "type": "integer",
        "enum": [
          1,
          2
        ],
        "description": "1: the first end-to-end pilot (scripted continuation, shared-prefix branching, fixed tools); 2: draft protocol shapes that do not block validating the integration (H2, H5)."
      },
      "framing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension_id",
          "contrast_id"
        ],
        "properties": {
          "dimension_id": {
            "type": "string",
            "minLength": 1
          },
          "contrast_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "A dimension and contrast declared in docs/framework/framing_dimensions.draft.json."
      },
      "speaker_identity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "note"
        ],
        "properties": {
          "policy": {
            "type": "string",
            "enum": [
              "constant",
              "factor"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "constant: every arm declares the same user_is, so register never changes who is speaking; factor: speaker identity is a declared experimental factor and arms may differ, which the note must justify."
      },
      "scenario": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "topic",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "file",
              "item_id"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "item_id": {
                "type": "string"
              }
            },
            "description": "Where the stimulus text came from (a data/advice or data/simulated file); null for a synthetic example."
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier",
              "warning_signs_text_ref",
              "evidence_direction"
            ],
            "properties": {
              "tier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "warning_signs_text_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_direction": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "description": "Adjudicated reference data the reference-dependent outcome dimensions need; null until adjudicated."
          }
        }
      },
      "texts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "text",
            "sha256",
            "register",
            "authored_by"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "register": {
              "type": "string",
              "enum": [
                "colloquial",
                "clinical",
                "mixed",
                "not_applicable"
              ]
            },
            "authored_by": {
              "type": "string",
              "enum": [
                "study_data",
                "owner",
                "synthetic_example"
              ]
            }
          }
        },
        "description": "Every target-visible string, keyed for reference; sha256 is of the UTF-8 text."
      },
      "system_prompt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "text_ref",
          "variants"
        ],
        "properties": {
          "policy": {
            "type": "string",
            "enum": [
              "none",
              "fixed",
              "variants"
            ]
          },
          "text_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text_ref"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "text_ref": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "none: no system message (matches the advice archive); fixed: one text; variants: a root-level factor."
      },
      "tools": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "definitions",
          "results"
        ],
        "properties": {
          "definitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description",
                "parameters"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tool",
                "text_ref",
                "marker"
              ],
              "properties": {
                "tool": {
                  "type": "string"
                },
                "text_ref": {
                  "type": "string"
                },
                "marker": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "description": "Fixed target tools plus a constant, data-supplied result per tool name (H3); null when the seed uses no tools."
      },
      "protocol": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arms",
          "register_exposure",
          "branch_anchor",
          "branches",
          "max_target_turns"
        ],
        "properties": {
          "arms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "user_is",
                "turns"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "user_is": {
                  "type": "string",
                  "enum": [
                    "patient",
                    "caregiver",
                    "clinician",
                    "unknown"
                  ]
                },
                "turns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "text_ref"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "user"
                        ]
                      },
                      "text_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "context_role": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "pressure",
                          "neutral_control",
                          "evidence",
                          "assertion",
                          "clarifier_answer",
                          null
                        ]
                      }
                    }
                  }
                }
              }
            },
            "description": "Root-level conditions; each arm is its own conversation tree (per repeat)."
          },
          "register_exposure": {
            "type": "string",
            "enum": [
              "single_turn",
              "initial_only",
              "sustained"
            ],
            "description": "single_turn: one user turn per arm, no branches. initial_only: turn 1 differs by register and every later user turn (arm turns and branch turns) is byte-identical across arms; measures persistence of an initial register cue. sustained: every user turn has a declared register counterpart across arms; measures divergence under continued exposure. The two multi-turn estimands are never pooled."
          },
          "branch_anchor": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "after_arm_turn",
              "anchor"
            ],
            "properties": {
              "after_arm_turn": {
                "type": "integer",
                "minimum": 1
              },
              "anchor": {
                "type": "string",
                "enum": [
                  "assistant"
                ]
              }
            },
            "description": "Branches fork from the ASSISTANT reply to the given arm turn, so siblings share that realized reply. Anchoring on the user turn would regenerate the reply."
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "turns"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "turns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "text_ref"
                    ],
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "user"
                        ]
                      },
                      "text_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "context_role": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "pressure",
                          "neutral_control",
                          "evidence",
                          "assertion",
                          "clarifier_answer",
                          null
                        ]
                      }
                    }
                  }
                }
              }
            },
            "description": "Post-anchor continuations; empty when branch_anchor is null."
          },
          "max_target_turns": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "auditor_instruction": {
        "type": [
          "string",
          "null"
        ],
        "description": "Free text for an LLM auditor; non-null only when mode is autonomous; null when scripted."
      },
      "generation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temperature",
          "max_tokens",
          "seed_requested"
        ],
        "properties": {
          "temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "seed_requested": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "description": "Target sampling settings; seed_requested null means no provider seed is requested (provisional pilot policy)."
      },
      "judge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "advice_tier",
          "outcome_dimensions",
          "supplied_contexts"
        ],
        "properties": {
          "advice_tier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "response_only",
              "contextual"
            ],
            "properties": {
              "response_only": {
                "type": "boolean"
              },
              "contextual": {
                "type": "boolean"
              }
            },
            "description": "Which tier instruments run (outcome registry tier_instruments). Both are preserved in the pilot for every turn after the first."
          },
          "outcome_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supplied_contexts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension_id",
                "text_ref"
              ],
              "properties": {
                "dimension_id": {
                  "type": "string",
                  "minLength": 1
                },
                "text_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "description": "Data strings a supplied-context dimension receives as context (for example the asserted proposition for assertion_handling); tool results and evidence turns are taken from tools.results and context_role turns and need no entry."
          }
        }
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "seeds": [
    {
